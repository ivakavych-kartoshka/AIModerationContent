\newlabel{sec:supp-significance}{{10}{31}{Complete Pairwise Significance Matrix}{section.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Complete pairwise comparison of all $\binom  {6}{2}=15$ system pairs. $\Delta $M-F1 is the paired-bootstrap difference ($A$ minus $B$) with a 95\% CI, $p_{\text  {F1}}$ its bootstrap $p$-value; $p_{\text  {acc}}$ is the exact two-sided McNemar $p$-value on accuracy. $^{\dagger }$ marks $p<0.05$ after a Holm--Bonferroni step-down correction over these 15 tests.}}{31}{table.9}\protected@file@percent }
\newlabel{tab:supp-pairs}{{9}{31}{Complete pairwise comparison of all $\binom {6}{2}=15$ system pairs. $\Delta $M-F1 is the paired-bootstrap difference ($A$ minus $B$) with a 95\% CI, $p_{\text {F1}}$ its bootstrap $p$-value; $p_{\text {acc}}$ is the exact two-sided McNemar $p$-value on accuracy. $^{\dagger }$ marks $p<0.05$ after a Holm--Bonferroni step-down correction over these 15 tests}{table.9}{}}
\@writefile{toc}{\contentsline {section}{\numberline {11}Post-hoc Decision-Rule Diagnostic}{31}{section.11}\protected@file@percent }
\newlabel{sec:supp-threshold}{{11}{31}{Post-hoc Decision-Rule Diagnostic}{section.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Post-hoc prior-reweighting diagnostic. The frozen posteriors are reweighted by a joint factor $u$ on the two minority classes and re-argmaxed; $u^{\star }$ is the \emph  {oracle} factor that maximises test macro-F1. ``argmax M-F1'' is the macro-F1 of a plain argmax on the frozen posteriors; it differs from the system's headline macro-F1 only for M4, whose validation-searched thresholds ($0.01/0.5/0.64$) \emph  {lowered} test macro-F1 from the argmax $0.6602$ to the reported $0.6590$. $u^{\star }$ is chosen on the test labels and the gain is therefore an oracle upper bound over this one-parameter reweighting family, not a deployable decision rule.}}{32}{table.10}\protected@file@percent }
\newlabel{tab:supp-threshold}{{10}{32}{Post-hoc prior-reweighting diagnostic. The frozen posteriors are reweighted by a joint factor $u$ on the two minority classes and re-argmaxed; $u^{\star }$ is the \emph {oracle} factor that maximises test macro-F1. ``argmax M-F1'' is the macro-F1 of a plain argmax on the frozen posteriors; it differs from the system's headline macro-F1 only for M4, whose validation-searched thresholds ($0.01/0.5/0.64$) \emph {lowered} test macro-F1 from the argmax $0.6602$ to the reported $0.6590$. $u^{\star }$ is chosen on the test labels and the gain is therefore an oracle upper bound over this one-parameter reweighting family, not a deployable decision rule}{table.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {49}{\ignorespaces Test macro-F1 as a function of the minority reweighting factor $u$ for the six systems. The curves are flat near their maxima: no threshold change recovers a meaningful amount of macro-F1.}}{32}{figure.49}\protected@file@percent }
\newlabel{fig:supp-threshold}{{49}{32}{Test macro-F1 as a function of the minority reweighting factor $u$ for the six systems. The curves are flat near their maxima: no threshold change recovers a meaningful amount of macro-F1}{figure.49}{}}
