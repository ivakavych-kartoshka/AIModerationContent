\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Resolved per-system configuration as recorded in each run's \texttt  {training\_summary.json} and \texttt  {configs/*.yaml}. ``lr'' is the stage-1 encoder rate; ``head lr'' the discriminative head rate when DLR is on. ``thr.''\ marks the systems whose test pass applied per-class thresholds searched on validation (M3--M6, read from each run's \texttt  {metrics.json}); the search returned the trivial $0.5$ for all but M4. AdamW, weight decay 0.01, gradient clipping 1.0 and max length 256 are shared.}}{33}{table.11}\protected@file@percent }
\newlabel{tab:supp-hyperparameters}{{11}{33}{Resolved per-system configuration as recorded in each run's \texttt {training\_summary.json} and \texttt {configs/*.yaml}. ``lr'' is the stage-1 encoder rate; ``head lr'' the discriminative head rate when DLR is on. ``thr.''\ marks the systems whose test pass applied per-class thresholds searched on validation (M3--M6, read from each run's \texttt {metrics.json}); the search returned the trivial $0.5$ for all but M4. AdamW, weight decay 0.01, gradient clipping 1.0 and max length 256 are shared}{table.11}{}}
