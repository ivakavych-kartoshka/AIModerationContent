\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Post-hoc statistics on the frozen test predictions. \emph  {Top:} accuracy and macro-F1 with 95\% percentile bootstrap intervals (10,000 resamples of the 6,680 test items) and the top-label expected calibration error (ECE, 10 bins). \emph  {Bottom:} paired comparisons, $A$ minus $B$, with a 95\% paired-bootstrap interval on macro-F1; $p_{\text  {F1}}$ is the paired-bootstrap $p$-value and $p_{\text  {acc}}$ the exact two-sided McNemar $p$-value on the two systems' correctness. $^{\dagger }$ marks $p<0.05$ after a Holm--Bonferroni correction over the seven comparisons below; values below $0.001$ are shown as $<0.001$. No macro-F1 gap is significant; the only differences that survive correction are the two accuracy gaps involving M6, discussed in the text.}}{11}{table.5}\protected@file@percent }
\newlabel{tab:significance}{{5}{11}{Post-hoc statistics on the frozen test predictions. \emph {Top:} accuracy and macro-F1 with 95\% percentile bootstrap intervals (10,000 resamples of the 6,680 test items) and the top-label expected calibration error (ECE, 10 bins). \emph {Bottom:} paired comparisons, $A$ minus $B$, with a 95\% paired-bootstrap interval on macro-F1; $p_{\text {F1}}$ is the paired-bootstrap $p$-value and $p_{\text {acc}}$ the exact two-sided McNemar $p$-value on the two systems' correctness. $^{\dagger }$ marks $p<0.05$ after a Holm--Bonferroni correction over the seven comparisons below; values below $0.001$ are shown as $<0.001$. No macro-F1 gap is significant; the only differences that survive correction are the two accuracy gaps involving M6, discussed in the text}{table.5}{}}
\newlabel{tab:confidence}{{5}{11}{Post-hoc statistics on the frozen test predictions. \emph {Top:} accuracy and macro-F1 with 95\% percentile bootstrap intervals (10,000 resamples of the 6,680 test items) and the top-label expected calibration error (ECE, 10 bins). \emph {Bottom:} paired comparisons, $A$ minus $B$, with a 95\% paired-bootstrap interval on macro-F1; $p_{\text {F1}}$ is the paired-bootstrap $p$-value and $p_{\text {acc}}$ the exact two-sided McNemar $p$-value on the two systems' correctness. $^{\dagger }$ marks $p<0.05$ after a Holm--Bonferroni correction over the seven comparisons below; values below $0.001$ are shown as $<0.001$. No macro-F1 gap is significant; the only differences that survive correction are the two accuracy gaps involving M6, discussed in the text}{table.5}{}}
