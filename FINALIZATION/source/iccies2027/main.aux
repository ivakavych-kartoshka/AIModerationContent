\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Decision-level variants for the focused backbone (\textsc  {sensitiveai-vi-custom}) on test. Every variant reads the same frozen scores; only mixing and the decision rule differ; the last row is primary. \emph  {All evaluation metrics, including accuracy, macro-F1, and per-class F1-scores, are reported as percentages (\%).} Best value in each column is bold. The two global-$\alpha $ rows coincide because the tuned thresholds do not change any validation prediction under a single global weight. Rule-only rows are scored inside the fusion pipeline on renormalised rule scores; the standalone engine with its own thresholds is reported in the text.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:fusion-variants}{{2}{8}{Decision-level variants for the focused backbone (\model {sensitiveai-vi-custom}) on test. Every variant reads the same frozen scores; only mixing and the decision rule differ; the last row is primary. \emph {All evaluation metrics, including accuracy, macro-F1, and per-class F1-scores, are reported as percentages (\%).} Best value in each column is bold. The two global-$\alpha $ rows coincide because the tuned thresholds do not change any validation prediction under a single global weight. Rule-only rows are scored inside the fusion pipeline on renormalised rule scores; the standalone engine with its own thresholds is reported in the text}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Precision and recall on test for the focused backbone (\textsc  {sensitiveai-vi-custom}), over the same eight systems as Table~\ref {tab:fusion-variants}. Per-class columns are precision (P) and recall (R); macro averages are unweighted means. All evaluation metrics, including precision and recall, are reported as percentages (\%). Best value in each column is bold. Different systems win different columns: the logistic meta-classifier has the highest recall but the lowest macro-F1 (Table~\ref {tab:fusion-variants}), which aggregate F1 hides.}}{8}{table.3}\protected@file@percent }
\newlabel{tab:precision-recall}{{3}{8}{Precision and recall on test for the focused backbone (\model {sensitiveai-vi-custom}), over the same eight systems as Table~\ref {tab:fusion-variants}. Per-class columns are precision (P) and recall (R); macro averages are unweighted means. All evaluation metrics, including precision and recall, are reported as percentages (\%). Best value in each column is bold. Different systems win different columns: the logistic meta-classifier has the highest recall but the lowest macro-F1 (Table~\ref {tab:fusion-variants}), which aggregate F1 hides}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Focused backbone. (a)\ Macro-F1 of each variant (dotted: AI-only). (b)\ Provenance of the 38 changed decisions. (c)\ Rule-channel coverage, precision when firing, recall on non-\textsc  {clean}{}, and false alarms on \textsc  {clean}{} (percentages).}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:results}{{2}{9}{Focused backbone. (a)\ Macro-F1 of each variant (dotted: AI-only). (b)\ Provenance of the 38 changed decisions. (c)\ Rule-channel coverage, precision when firing, recall on non-\clean {}, and false alarms on \clean {} (percentages)}{figure.2}{}}
